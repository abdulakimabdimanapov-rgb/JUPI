static func get_weapon(id: String) -> Dictionary:
	return WEAPONS.get(id, WEAPONS["combat_knife"]).duplicate()

static func get_all_weapons() -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for id in WEAPONS:
		result.append(WEAPONS[id])
	return result

static func get_weapons_by_rarity(rarity: String) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for id in WEAPONS:
		if WEAPONS[id].get("rarity", "common") == rarity:
			result.append(WEAPONS[id])
	return result

static func calculate_damage(weapon_id: String, level_bonus: float = 0.0, is_crit: bool = false) -> float:
	var w := get_weapon(weapon_id)
	var base: float = w.get("damage", 18.0)
	var total := base + level_bonus
	if is_crit:
		total *= w.get("crit_multiplier", 2.0)
	return total
