{
  "project_name": "TIME HUNTER: THE BLOOD CLOCK",
  "engine": "godot",
  "engine_version": "4.7",
  "renderer": "gl_compatibility",

  "asset_root": "res://assets/2d",
  "generated_root": "tools/ai/generated",
  "cache_root": "tools/ai/cache",
  "manifest_path": "tools/ai/cache/manifest.json",

  "pixel_art": {
    "tile_size": 16,
    "sheet_columns": 8,
    "texture_filter": "nearest",
    "format": "RGBA8",
    "max_colors_per_sprite": 16,
    "outline_color": "#1a1420",
    "outline_width": 1,
    "light_direction": "top-left",
    "max_file_size_kb": 50,
    "max_sheet_size_kb": 200
  },

  "comfyui": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8188,
    "timeout_seconds": 120,
    "poll_interval_ms": 500,
    "output_dir": "tools/ai/generated",
    "models": {
      "pixel_art": "pixel_art_v1.safetensors",
      "environment": "pixel_art_v1.safetensors",
      "character": "pixel_art_v1.safetensors",
      "upscaler": "4x_NMKD-Superscale-SP_178000_G.pth"
    }
  },

  "fallback": {
    "enabled": true,
    "use_procedural": true,
    "procedural_script": "res://scripts/2d/gen_assets_2d.gd"
  },

  "validation": {
    "enabled": true,
    "strict_mode": false,
    "auto_accept_threshold": 0.8,
    "checks": {
      "file_exists": true,
      "format_png": true,
      "resolution": true,
      "transparency": true,
      "spritesheet_layout": true,
      "frame_count": true,
      "naming_convention": true,
      "file_size": true,
      "no_corruption": true,
      "palette_compliance": true,
      "outline_exists": true
    }
  },

  "export": {
    "auto_import": false,
    "backup_existing": true,
    "backup_dir": "tools/ai/cache/backups",
    "overwrite_protection": true
  },

  "asset_types": {
    "characters": {
      "target_dir": "res://assets/2d/characters",
      "size": [16, 16],
      "animations": ["IDLE", "MOVE", "ATTACK", "ALT_ATTACK", "HURT"],
      "sheet_rows": 5
    },
    "enemies": {
      "target_dir": "res://assets/2d/enemies",
      "size": [16, 16],
      "animations": ["IDLE", "MOVE", "ATTACK", "HURT", "DEATH"],
      "sheet_rows": 5
    },
    "animals": {
      "target_dir": "res://assets/2d/animals",
      "size": [16, 16],
      "animations": ["IDLE", "MOVE", "HURT", "ABSORB_REACTION"],
      "sheet_rows": 4
    },
    "npcs": {
      "target_dir": "res://assets/2d/characters",
      "size": [16, 16],
      "animations": ["IDLE", "WALK", "ALERT", "CHASE", "HURT"],
      "sheet_rows": 5
    },
    "tiles": {
      "target_dir": "res://assets/2d/tiles",
      "size": [16, 16],
      "atlas_size": [128, 80],
      "atlas_grid": [8, 5]
    },
    "environment": {
      "target_dir": "res://assets/2d/environment",
      "size": [16, 16]
    },
    "hud": {
      "target_dir": "res://assets/2d/hud",
      "size": "variable"
    },
    "ui": {
      "target_dir": "res://assets/2d/ui",
      "size": "variable"
    },
    "backgrounds": {
      "target_dir": "res://assets/2d/backgrounds",
      "size": "variable"
    },
    "clock": {
      "target_dir": "res://assets/2d/clock",
      "size": [32, 32]
    }
  },

  "prompt_defaults": {
    "style": "pixel art",
    "era": "dark cyberpunk noir",
    "mood": "night, rainy, atmospheric",
    "perspective": "top-down",
    "palette_constraint": "muted dark tones with selective neon accents"
  }
}
