{
  "name": "Character Sheet Generator",
  "description": "Generates multi-row character animation sheets",
  "version": "1.0",

  "nodes": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "pixel_art_v1.safetensors" },
      "_meta": { "title": "Load Checkpoint" }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "pixel art, 16x16, top-down, {character_name} sprite sheet, {animation_name} animation, {frame_count} frames in a row, dark cyberpunk noir, flat colors, 1px dark outline, no gradients, transparent background, game asset, consistent proportions across frames",
        "clip": ["1", 1]
      },
      "_meta": { "title": "Positive Prompt" }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "photorealistic, 3d, gradient, blur, multiple characters, inconsistent, varying sizes, anti-aliasing, smooth",
        "clip": ["1", 1]
      },
      "_meta": { "title": "Negative Prompt" }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 256,
        "batch_size": 1
      },
      "_meta": { "title": "Wide canvas for frame strip" }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0],
        "latent_image": ["4", 0],
        "seed": "{seed}", "steps": 30, "cfg": 8.0,
        "sampler_name": "euler_ancestral", "scheduler": "normal", "denoise": 1.0
      },
      "_meta": { "title": "KSampler" }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["5", 0], "vae": ["1", 2] },
      "_meta": { "title": "VAE Decode" }
    },
    "7": {
      "class_type": "ImageScale",
      "inputs": {
        "image": ["6", 0], "upscale_method": "nearest-exact",
        "width": "{frame_count_times_16}", "height": 16, "crop": "center"
      },
      "_meta": { "title": "Downscale to frame strip" }
    },
    "8": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["7", 0],
        "filename_prefix": "generated/{character_name}_{animation_name}_sheet"
      },
      "_meta": { "title": "Save Animation Row" }
    }
  },

  "metadata": {
    "notes": "Generate one row per animation, then stitch into full sheet using tools/ai/scripts/stitch_sheet.py"
  }
}
