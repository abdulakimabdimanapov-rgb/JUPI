{
  "name": "Pixel Art 16x16 Sprite Generator",
  "description": "Generates 16x16 pixel art sprites with the project's style guide",
  "version": "1.0",
  "author": "TIME HUNTER AI Pipeline",

  "nodes": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "pixel_art_v1.safetensors"
      },
      "_meta": { "title": "Load Checkpoint" }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{prompt}",
        "clip": ["1", 1]
      },
      "_meta": { "title": "Positive Prompt" }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "photorealistic, 3d render, gradient, blur, anti-aliasing, multiple characters, complex background, smooth, vector, anime, cartoon, text, watermark",
        "clip": ["1", 1]
      },
      "_meta": { "title": "Negative Prompt" }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 512,
        "height": 512,
        "batch_size": 1
      },
      "_meta": { "title": "Latent Canvas (512x512 for quality)" }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0],
        "seed": "{seed}",
        "steps": 20,
        "cfg": 8.0,
        "sampler_name": "euler_ancestral",
        "scheduler": "normal",
        "denoise": 1.0
      },
      "_meta": { "title": "KSampler" }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["5", 0],
        "vae": ["1", 2]
      },
      "_meta": { "title": "VAE Decode" }
    },
    "7": {
      "class_type": "ImageScale",
      "inputs": {
        "image": ["6", 0],
        "upscale_method": "nearest-exact",
        "width": 16,
        "height": 16,
        "crop": "center"
      },
      "_meta": { "title": "Downscale to 16x16 (nearest)" }
    },
    "8": {
      "class_type": "ImageScale",
      "inputs": {
        "image": ["7", 0],
        "upscale_method": "nearest-exact",
        "width": 128,
        "height": 16,
        "crop": "disabled"
      },
      "_meta": { "title": "Upscale to 128x16 for sheet layout" }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["8", 0],
        "filename_prefix": "generated/{asset_name}"
      },
      "_meta": { "title": "Save Generated Sheet" }
    }
  },

  "metadata": {
    "style_guide_ref": "tools/ai/STYLE_GUIDE.md",
    "tile_size": 16,
    "sheet_columns": 8,
    "texture_filter": "nearest",
    "output_format": "PNG",
    "notes": "This workflow generates a single animation row (8 frames) at 16x16. For full sheets, run multiple times with different prompts and stitch."
  }
}
