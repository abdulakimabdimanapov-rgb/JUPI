func _gen_clock_face() -> void:
	var img := _new_img(32, 32)
	_disc(img, 16, 16, 14.0, Color(0.20, 0.18, 0.15))
	_disc(img, 16, 16, 12.0, Color(0.25, 0.22, 0.18))
	_disc(img, 16, 16, 10.0, Color(0.30, 0.27, 0.22))
	_disc(img, 16, 16, 8.0, Color(0.85, 0.80, 0.70))
	for a in range(12):
		var ang := a * TAU / 12.0 - PI / 2
		var mx := 16 + cos(ang) * 7
		var my := 16 + sin(ang) * 7
		_px(img, int(mx), int(my), Color(0.20, 0.18, 0.15))
	_rect(img, 15, 9, 2, 7, Color(0.15, 0.12, 0.10))
	_rect(img, 16, 8, 1, 8, Color(0.20, 0.18, 0.15))
	_disc(img, 16, 16, 1.0, Color(0.80, 0.20, 0.15))
	_disc(img, 16, 16, 0.5, Color(0.90, 0.25, 0.20))
	_save(img, "res://assets/2d/clock/clock_face.png")

