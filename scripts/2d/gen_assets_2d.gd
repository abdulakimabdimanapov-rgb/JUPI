extends SceneTree


const TILE := 16

func _initialize() -> void:
	_gen_tile_atlas()
	_gen_hunter()
	_gen_enemy_guard()
	_gen_enemy_fast()
	_gen_enemy_heavy()
	_gen_npc()
	_gen_clock_face()
	_gen_hud_elements()
	print("[gen_assets] TIME HUNTER assets generated")
	quit(0)

func _new_img(w: int, h: int) -> Image:
	return Image.create(w, h, false, Image.FORMAT_RGBA8)

func _px(img: Image, x: int, y: int, c: Color) -> void:
	if x >= 0 and y >= 0 and x < img.get_width() and y < img.get_height():
		img.set_pixel(x, y, c)

func _rect(img: Image, x0: int, y0: int, w: int, h: int, c: Color) -> void:
	for y in range(y0, y0 + h):
		for x in range(x0, x0 + w):
			_px(img, x, y, c)

func _disc(img: Image, cx: float, cy: float, r: float, c: Color) -> void:
	for y in range(int(cy - r) - 1, int(cy + r) + 2):
		for x in range(int(cx - r) - 1, int(cx + r) + 2):
			if Vector2(x - cx, y - cy).length() <= r:
				_px(img, x, y, c)

func _save(img: Image, path: String) -> void:
	var err := img.save_png(path)
	if err != OK:
		push_error("save failed %s err=%d" % [path, err])

